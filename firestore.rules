rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email == 'admin@fitbrother.app' ||
        request.auth.token.admin == true
      );
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Public approved trainers — read; writes via admin / approve flow
    match /trainers/{trainerId} {
      allow read: if true;
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == trainerId);
      allow delete: if isAdmin();
    }

    match /trainerApplications/{id} {
      allow create: if signedIn();
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /guidanceThreads/{threadId} {
      allow read: if signedIn() && (
        resource.data.memberId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn();
      allow update: if signedIn() && (
        resource.data.memberId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if false;
      }
    }

    match /guidanceSessions/{id} {
      allow read: if signedIn() && (
        resource.data.memberId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn();
      allow update: if signedIn();
    }

    match /guidanceRatings/{id} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /reports/{id} {
      allow create: if signedIn();
      allow read: if isAdmin();
    }
  }
}
