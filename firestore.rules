rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    // Admin via Auth custom claim only — email matching is privilege escalation.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }
    function threadDoc(threadId) {
      return get(/databases/$(database)/documents/guidanceThreads/$(threadId)).data;
    }
    function isThreadParticipant(threadId) {
      return signedIn() && (
        threadDoc(threadId).memberId == request.auth.uid ||
        threadDoc(threadId).trainerId == request.auth.uid ||
        isAdmin()
      );
    }

    match /trainers/{trainerId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == trainerId
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['verified', 'status', 'ratingAvg', 'ratingCount', 'uid', 'id'])
      );
      allow delete: if isAdmin();
    }

    match /trainerApplications/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /guidanceThreads/{threadId} {
      allow read: if signedIn() && (
        resource.data.memberId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.memberId == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.memberId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isAdmin()
      );

      match /messages/{messageId} {
        allow read: if isThreadParticipant(threadId);
        allow create: if isThreadParticipant(threadId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /guidanceSessions/{id} {
      allow read: if signedIn() && (
        resource.data.memberId == request.auth.uid ||
        resource.data.trainerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.paymentStatus == 'unpaid';
      // Member: mark_paid only. Trainer/admin: confirm payment.
      allow update: if signedIn() && (
        (
          resource.data.memberId == request.auth.uid
          && request.resource.data.paymentStatus == 'marked_paid'
          && resource.data.paymentStatus in ['unpaid', 'marked_paid']
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['paymentStatus'])
        )
        || (
          (resource.data.trainerId == request.auth.uid || isAdmin())
          && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['paymentStatus', 'scheduledAt'])
        )
      );
    }

    match /guidanceRatings/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.memberId == request.auth.uid
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5;
      allow update, delete: if false;
    }

    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if isAdmin();
    }
  }
}
