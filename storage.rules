rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isThreadParticipant(threadId) {
      return request.auth != null && (
        firestore.get(/databases/(default)/documents/guidanceThreads/$(threadId)).data.memberId
          == request.auth.uid
        || firestore.get(/databases/(default)/documents/guidanceThreads/$(threadId)).data.trainerId
          == request.auth.uid
        || request.auth.token.admin == true
      );
    }

    match /voice/{threadId}/{fileName} {
      allow read: if isThreadParticipant(threadId);
      allow write: if isThreadParticipant(threadId)
        && request.resource.size < 2 * 1024 * 1024
        && (request.resource.contentType.matches('audio/.*')
            || request.resource.contentType == 'application/octet-stream');
    }
  }
}
