# Copy values into app.json → expo.extra (or EAS secrets). Never commit real keys.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# false when Firebase keys are configured
EXPO_PUBLIC_USE_DEMO_MODE=true

# Spark substitute for Cloud Functions — trainer apply opens mailto
EXPO_PUBLIC_ADMIN_NOTIFY_EMAIL=admin@fitbrother.app
