# Copy to .env (gitignored). app.config.js maps these into expo.extra.
# EXPO_PUBLIC_* values ship in the client bundle — public Firebase Web config only.
# Never put Admin SDK keys, Stripe secrets, or DB URLs here. Never commit .env.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# false when Firebase Auth + Firestore are ready
EXPO_PUBLIC_USE_DEMO_MODE=true

# Trainer apply opens mailto (Spark substitute for Cloud Functions)
EXPO_PUBLIC_ADMIN_NOTIFY_EMAIL=admin@fitbrother.app
